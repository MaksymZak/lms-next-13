{
  "name": "lms-next-13",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check-format": "prettier --check .",
    "format": "prettier --write .",
    "test": "bun run check-format && bun run lint",
    "fix": "bun run format && bun run lint --fix",
    "test-all": "bun run check-format && bun run lint && bun run build",
    "postinstall": "prisma generate",
    "db:start": "docker start lms_postgres || docker run --name lms_postgres -p 5432:5432 -e POSTGRES_PASSWORD=123456 -d postgres:16",
    "db:stop": "docker stop lms_postgres",
    "db:push": "prisma db push",
    "db:seed": "bun run scripts/seed.ts",
    "db:studio": "prisma studio"
  },
