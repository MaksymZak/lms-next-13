# Скопируйте в .env и заполните значения

# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Database ----------
# Локальный postgres: bun run db:start
DATABASE_URL='postgresql://postgres:123456@localhost:5432/lms'

# ---------- Better Auth ----------
# Сгенерировать: openssl rand -base64 32
BETTER_AUTH_SECRET=

# ---------- File storage ----------
# local = файлы в ./.uploads (работает из коробки)
# r2    = Cloudflare R2, пошаговая настройка: docs/SETUP_R2.md
STORAGE_DRIVER=local
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=lms-files
# R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# ---------- Stripe (опционально; без него работают только бесплатные курсы) ----------
# stripe listen --forward-to localhost:3000/api/webhook
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
